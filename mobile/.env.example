# SHEild AI Mobile Environment Configuration
# Copy this file to .env or .env.local to configure environment variables for local testing.

# Base API URL for FastAPI Backend
# Default (Android Emulator): http://10.0.2.2:8000/api/v1
# Default (Web/iOS Simulator): http://localhost:8000/api/v1
# Physical Android Device (LAN): http://<YOUR_LOCAL_IP>:8000/api/v1 (e.g., http://192.168.1.50:8000/api/v1)
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
# MapLibre Vector Tile Style URL & Provider Configuration
# -----------------------------------------------------------------------------------------
# IMPORTANT TILE PROVIDER & LICENSING NOTICE:
# 1. Fallback Demo Style (Default): https://demotiles.maplibre.org/style.json
#    Demotiles is strictly a low-zoom demo dataset (maxzoom 6, country boundaries only).
#    It does NOT contain street-level roads, footpaths, or transit details.
#
# 2. Production Street-Level Vector Provider (RECOMMENDED):
#    MapTiler Cloud provides OpenMapTiles-compatible vector tiles up to zoom 14-22.
#    - Terms of Service explicitly authorize mobile offline caching with MapLibre Native.
#    - Free tier includes 100,000 requests/month (no credit card required).
#    - Attribution: "© MapTiler © OpenStreetMap contributors".
#    - Sign up at https://cloud.maptiler.com/, copy your API key, and configure below:
#      EXPO_PUBLIC_MAP_API_KEY=your_maptiler_key_here
#      EXPO_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/dataviz-dark/style.json?key=your_maptiler_key_here
#
# 3. Alternative Vector Provider (Stadia Maps):
#    - Style: https://tiles.stadiamaps.com/styles/alidade_smooth_dark.json?api_key=<KEY>
#    - Terms allow mobile SDK caching; requires "© Stadia Maps © OpenMapTiles © OpenStreetMap contributors".
#
# DO NOT scrape public OSM (tile.openstreetmap.org) or CARTO tile servers.
EXPO_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
EXPO_PUBLIC_MAP_API_KEY=

